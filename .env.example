# ==============================================================================
# HACK THE HORIZON 2.0 — PRODUCTION CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production

# Public Site URL (optional - leave blank to auto-detect origin for LAN / WiFi Smart Boards)
NEXT_PUBLIC_SITE_URL=

# Admin Portal Credentials
NEXT_PUBLIC_ADMIN_EMAIL=admin@hth.com
NEXT_PUBLIC_ADMIN_PASSWORD=admin123

# WebRTC ICE Servers (STUN/TURN) - JSON array string (optional, defaults to Google & Cloudflare STUN)
# Example with custom TURN:
# NEXT_PUBLIC_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.myhost.com:3478","username":"user","credential":"pwd"}]'
NEXT_PUBLIC_ICE_SERVERS=

# Database Connection (SQLite)
DATABASE_URL="file:./dev.db"
